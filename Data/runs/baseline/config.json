{
  "stage": "train",
  "data_dir": "./data",
  "val_split": 0.1,
  "subset_fraction": 1.0,
  "normalize": true,
  "augment": "crop_flip",
  "label_smoothing": 0.0,
  "leak": "none",
  "batch_size": 128,
  "num_workers": 2,
  "stem": "cifar",
  "width": 64,
  "residual": true,
  "dropout": 0.0,
  "epochs": 30,
  "optimizer": "sgd",
  "lr": 0.1,
  "momentum": 0.9,
  "weight_decay": 0.0005,
  "scheduler": "cosine",
  "overfit_steps": 100,
  "seed": 42,
  "run_name": "baseline",
  "output_dir": "./runs"
}